#!/bin/sh
set -e

if git diff --cached --quiet --diff-filter=ACMR -- '*.php'; then
    exit 0
fi

echo "→ Pint sur les fichiers PHP stagés..."
git diff --cached --name-only --diff-filter=ACMR -z -- '*.php' | xargs -0 ./vendor/bin/pint --test

echo "→ PHPStan..."
./vendor/bin/phpstan analyse --memory-limit=2G --no-progress
