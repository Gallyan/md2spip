APP_NAME="Markdown to SPIP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

APP_MAINTENANCE_DRIVER=file

# Legal notice — Editor (empty variables = lines hidden on the page)
LEGAL_EDITOR_NAME=
LEGAL_EDITOR_ADDRESS=
LEGAL_EDITOR_PHONE=
LEGAL_CONTACT_EMAIL=
SOCIAL_WEBSITE=

# Legal notice — Hosting (section hidden if LEGAL_HOSTING_NAME is empty)
LEGAL_HOSTING_NAME=
LEGAL_HOSTING_ADDRESS=
LEGAL_HOSTING_PHONE=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
# Préfixe __Host- : le navigateur impose Secure + Path=/ + pas de Domain.
SESSION_COOKIE=__Host-md2spip-session

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
