APP_NAME="Markdown to SPIP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

APP_MAINTENANCE_DRIVER=file

# Mentions légales — Éditeur (variables vides = lignes non affichées)
LEGAL_EDITOR_NAME=
LEGAL_EDITOR_VAT=
LEGAL_EDITOR_ADDRESS=
LEGAL_EDITOR_PHONE=
LEGAL_CONTACT_EMAIL=
SOCIAL_WEBSITE=

# Mentions légales — Hébergement (section masquée si LEGAL_HOSTING_NAME est vide)
LEGAL_HOSTING_NAME=
LEGAL_HOSTING_ADDRESS=
LEGAL_HOSTING_PHONE=
LEGAL_HOSTING_SIRET=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=error

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
